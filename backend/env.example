# Application
APP_ENV=local
APP_NAME=loadguard
LOG_LEVEL=INFO

# Database (Postgres)
DATABASE_URL=postgresql+psycopg://anomaly:anomaly@localhost:5433/anomaly

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Schedules
RUN_AM_TIME=09:00
RUN_PM_TIME=14:00
SCHEDULER_TIMEZONE=Europe/Istanbul

# Security (simple internal API key guard)
INTERNAL_API_KEY=change-me

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173

# LLM (on-prem)
LLM_BASE_URL=http://localhost:9000
LLM_TIMEOUT_SECONDS=30
LLM_MODEL_NAME=internal-llm

# Email (optional; if unset, notifications are persisted only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.local
SMTP_USE_TLS=true

# Notifications
CRITICAL_ALERT_RECIPIENTS=ops-critical@example.local
WARNING_DIGEST_RECIPIENTS=ops-warn@example.local
WARNING_DIGEST_TIME=16:00


