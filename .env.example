# Copy to .env (docker compose reads it). Never commit real secrets.
LG_JWT_SECRET=change-me-to-a-long-random-string
LG_INGEST_API_KEY=change-me
LG_SIMULATOR_LIVE=true

# Advisory AI: none | openai_compatible | anthropic
LG_AI_PROVIDER=none
LG_AI_BASE_URL=
LG_AI_MODEL=
LG_AI_API_KEY=
# Omit unless the model needs it (some reject anything but the default); 0 for deterministic on-prem models
LG_AI_TEMPERATURE=

# Optional: Teams/Slack-compatible incoming webhook for P1/P2 incidents
LG_NOTIFY_WEBHOOK_URL=
